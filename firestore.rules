rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: /users/{uid} (User Profile & Ledger Settings)
// Document ID: {uid} (Firebase Auth UID)
// Fields:
//   - currency: string (required, 1..10 chars, e.g. "INR")
//   - weekStartsOn: int (required, 1..7, Mon=1 .. Sun=7)
//   - monthStartDay: int (required, 1..28)
//   - createdAt: timestamp (required, immutable on update)
//   - isVellumTheme: bool (optional)
//   - isBiometricEnabled: bool (optional)
//   - monthlyBudgetPaise: int (optional, >= 0)
//
// Collection: /users/{uid}/categories/{categoryId}
// Document ID: {categoryId}
// Fields:
//   - id: string (required, matches categoryId, immutable)
//   - name: string (required, 1..50 chars)
//   - kind: string (required, "expense" | "income")
//   - iconName: string (required, 1..50 chars)
//   - colorToken: string (required, 1..50 chars)
//   - order: int (required, >= 0)
//   - archived: bool (required)
//   - createdAt: timestamp (required, immutable on update)
//
// Collection: /users/{uid}/tags/{tagId}
// Document ID: {tagId}
// Fields:
//   - id: string (required, matches tagId, immutable)
//   - name: string (required, 1..30 chars)
//   - createdAt: timestamp (required, immutable on update)
//
// Collection: /users/{uid}/accounts/{accountId}
// Document ID: {accountId}
// Fields:
//   - id: string (optional, if present matches accountId, immutable)
//   - name: string (required, 1..50 chars)
//   - type: string (required, "cash" | "bank" | "upi" | "card")
//   - openingPaise: int (required)
//   - archived: bool (required)
//   - createdAt: timestamp (optional, immutable on update)
//
// Collection: /users/{uid}/transactions/{txnId}
// Document ID: {txnId}
// Fields:
//   - id: string (required, matches txnId, immutable)
//   - type: string (required, "expense" | "income" | "transfer")
//   - amountPaise: int (required, > 0)
//   - categoryId: string (required, 1..100 chars)
//   - accountId: string or null (optional, <= 100 chars)
//   - tagIds: list of strings (required, size <= 20)
//   - note: string (required, <= 200 chars)
//   - occurredAt: timestamp (required)
//   - dayKey: string (required, 1..20 chars, e.g. "YYYY-MM-DD")
//   - weekKey: string (required, 1..20 chars, e.g. "YYYY-Www")
//   - monthKey: string (required, 1..20 chars, e.g. "YYYY-MM")
//   - yearKey: string (required, 1..10 chars, e.g. "YYYY")
//   - createdAt: timestamp (required, immutable on update)
//   - updatedAt: timestamp (required)
//   - deletedAt: timestamp or null (optional)
//   - isSynced: bool (optional)
//
// Collection: /users/{uid}/summaries/{monthKey}
// Document ID: {monthKey} (e.g. "YYYY-MM")
// Fields:
//   - monthKey: string (required, matches monthKey, 1..20 chars, immutable)
//   - outPaise: int (required, >= 0)
//   - inPaise: int (required, >= 0)
//   - byCategory: map (required, map size <= 100)
//   - byDay: map (required, map size <= 35)
//   - updatedAt: timestamp (required)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    /// Checks if the request is from an authenticated user.
    function isAuthenticated() {
      return request.auth != null;
    }

    /// Validates that the authenticated user is the exclusive owner of this path.
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /// Verifies that all required fields exist in the incoming data.
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    /// Verifies that no unrecognized or unexpected fields exist in the incoming data.
    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    /// Verifies that specific immutable fields are not changed during an update.
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    /// Validates User Settings and Profile schema under /users/{uid}
    function isValidUserSettings(data) {
      return hasRequiredFields(data, ['currency', 'weekStartsOn', 'monthStartDay', 'createdAt']) &&
        hasOnlyAllowedFields(data, ['currency', 'weekStartsOn', 'monthStartDay', 'createdAt', 'isVellumTheme', 'isBiometricEnabled', 'monthlyBudgetPaise']) &&
        data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10 &&
        data.weekStartsOn is int && data.weekStartsOn >= 1 && data.weekStartsOn <= 7 &&
        data.monthStartDay is int && data.monthStartDay >= 1 && data.monthStartDay <= 28 &&
        data.createdAt is timestamp &&
        (!('isVellumTheme' in data) || data.isVellumTheme is bool) &&
        (!('isBiometricEnabled' in data) || data.isBiometricEnabled is bool) &&
        (!('monthlyBudgetPaise' in data) || (data.monthlyBudgetPaise is int && data.monthlyBudgetPaise >= 0));
    }

    /// Validates Category schema under /users/{uid}/categories/{categoryId}
    function isValidCategory(data, categoryId) {
      return hasRequiredFields(data, ['id', 'name', 'kind', 'iconName', 'colorToken', 'order', 'archived', 'createdAt']) &&
        hasOnlyAllowedFields(data, ['id', 'name', 'kind', 'iconName', 'colorToken', 'order', 'archived', 'createdAt']) &&
        data.id is string && data.id == categoryId &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 50 &&
        data.kind in ['expense', 'income'] &&
        data.iconName is string && data.iconName.size() > 0 && data.iconName.size() <= 50 &&
        data.colorToken is string && data.colorToken.size() > 0 && data.colorToken.size() <= 50 &&
        data.order is int && data.order >= 0 &&
        data.archived is bool &&
        data.createdAt is timestamp;
    }

    /// Validates Tag schema under /users/{uid}/tags/{tagId}
    function isValidTag(data, tagId) {
      return hasRequiredFields(data, ['id', 'name', 'createdAt']) &&
        hasOnlyAllowedFields(data, ['id', 'name', 'createdAt']) &&
        data.id is string && data.id == tagId &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 30 &&
        data.createdAt is timestamp;
    }

    /// Validates Account schema under /users/{uid}/accounts/{accountId}
    function isValidAccount(data, accountId) {
      return hasRequiredFields(data, ['name', 'type', 'openingPaise', 'archived']) &&
        hasOnlyAllowedFields(data, ['id', 'name', 'type', 'openingPaise', 'archived', 'createdAt']) &&
        (!('id' in data) || (data.id is string && data.id == accountId)) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 50 &&
        data.type in ['cash', 'bank', 'upi', 'card'] &&
        data.openingPaise is int &&
        data.archived is bool &&
        (!('createdAt' in data) || data.createdAt is timestamp);
    }

    /// Validates Transaction Entry schema under /users/{uid}/transactions/{txnId}
    function isValidTransaction(data, txnId) {
      return hasRequiredFields(data, [
        'id', 'type', 'amountPaise', 'categoryId', 'tagIds',
        'note', 'occurredAt', 'dayKey', 'weekKey', 'monthKey', 'yearKey',
        'createdAt', 'updatedAt'
      ]) &&
      hasOnlyAllowedFields(data, [
        'id', 'type', 'amountPaise', 'categoryId', 'accountId', 'tagIds',
        'note', 'occurredAt', 'dayKey', 'weekKey', 'monthKey', 'yearKey',
        'createdAt', 'updatedAt', 'deletedAt', 'isSynced'
      ]) &&
      data.id is string && data.id == txnId &&
      data.type in ['expense', 'income', 'transfer'] &&
      data.amountPaise is int && data.amountPaise > 0 &&
      data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 100 &&
      (!('accountId' in data) || data.accountId == null || (data.accountId is string && data.accountId.size() <= 100)) &&
      data.tagIds is list && data.tagIds.size() <= 20 &&
      data.note is string && data.note.size() <= 200 &&
      data.occurredAt is timestamp &&
      data.dayKey is string && data.dayKey.size() > 0 && data.dayKey.size() <= 20 &&
      data.weekKey is string && data.weekKey.size() > 0 && data.weekKey.size() <= 20 &&
      data.monthKey is string && data.monthKey.size() > 0 && data.monthKey.size() <= 20 &&
      data.yearKey is string && data.yearKey.size() > 0 && data.yearKey.size() <= 10 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp &&
      (!('deletedAt' in data) || data.deletedAt == null || data.deletedAt is timestamp) &&
      (!('isSynced' in data) || data.isSynced is bool);
    }

    /// Validates Precomputed Month Summary schema under /users/{uid}/summaries/{monthKey}
    function isValidSummary(data, monthKey) {
      return hasRequiredFields(data, ['monthKey', 'outPaise', 'inPaise', 'byCategory', 'byDay', 'updatedAt']) &&
        hasOnlyAllowedFields(data, ['monthKey', 'outPaise', 'inPaise', 'byCategory', 'byDay', 'updatedAt']) &&
        data.monthKey is string && data.monthKey == monthKey && data.monthKey.size() <= 20 &&
        data.outPaise is int && data.outPaise >= 0 &&
        data.inPaise is int && data.inPaise >= 0 &&
        data.byCategory is map && data.byCategory.size() <= 100 &&
        data.byDay is map && data.byDay.size() <= 35 &&
        data.updatedAt is timestamp;
    }

    // ===============================================================
    // Global Default Deny Rule
    // ===============================================================
    // Deny all reads and writes across the entire database by default.
    // Explicit access is only granted inside /users/{uid} for the authenticated owner.
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // User Scope / Data Isolation
    // ===============================================================
    // All personal data lives strictly under /users/{uid}.
    // Cross-user read or write access is strictly forbidden.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && isValidUserSettings(request.resource.data);
      allow update: if isOwner(uid) &&
                    isValidUserSettings(request.resource.data) &&
                    areImmutableFieldsUnchanged(['createdAt']);

      // -------------------------------------------------------------
      // Categories Subcollection
      // -------------------------------------------------------------
      match /categories/{categoryId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isValidCategory(request.resource.data, categoryId);
        allow update: if isOwner(uid) &&
                      isValidCategory(request.resource.data, categoryId) &&
                      areImmutableFieldsUnchanged(['id', 'createdAt']);
      }

      // -------------------------------------------------------------
      // Tags Subcollection
      // -------------------------------------------------------------
      match /tags/{tagId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isValidTag(request.resource.data, tagId);
        allow update: if isOwner(uid) &&
                      isValidTag(request.resource.data, tagId) &&
                      areImmutableFieldsUnchanged(['id', 'createdAt']);
      }

      // -------------------------------------------------------------
      // Accounts Subcollection
      // -------------------------------------------------------------
      match /accounts/{accountId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isValidAccount(request.resource.data, accountId);
        allow update: if isOwner(uid) &&
                      isValidAccount(request.resource.data, accountId) &&
                      areImmutableFieldsUnchanged(['id', 'createdAt']);
      }

      // -------------------------------------------------------------
      // Transactions Subcollection
      // -------------------------------------------------------------
      match /transactions/{txnId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isValidTransaction(request.resource.data, txnId);
        allow update: if isOwner(uid) &&
                      isValidTransaction(request.resource.data, txnId) &&
                      areImmutableFieldsUnchanged(['id', 'createdAt']);
      }

      // -------------------------------------------------------------
      // Month Summaries Subcollection
      // -------------------------------------------------------------
      match /summaries/{monthKey} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isValidSummary(request.resource.data, monthKey);
        allow update: if isOwner(uid) &&
                      isValidSummary(request.resource.data, monthKey) &&
                      areImmutableFieldsUnchanged(['monthKey']);
      }
    }
  }
}
